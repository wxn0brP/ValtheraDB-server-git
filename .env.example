# Port HTTP
PORT=14785

# Token autoryzacji (wymagany)
WOLF_TOKEN=your-secret-token-here

# Git repository
GIT_URL=https://github.com/user/repo.git
GIT_BRANCH=main
GIT_TOKEN=your-github-token-here

# Katalog lokalny danych (dla git adapter)
GIT_DIR=./data

# Delay auto-flush (ms)
FLUSH_DELAY=10000

# HTTPS (opcjonalny)
#SSL_CERT=./certs/cert.pem
#SSL_KEY=./certs/key.pem
#SSL_CA=./certs/ca.pem
#SSL_PORT=14786

# Rate limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=60000
